{%- layout 'theme' -%}

<div class="container">
  <div class="search-page">
    <h1>{{ page_title }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input 
        type="search" 
        name="q" 
        value="{{ search.terms | escape }}" 
        placeholder="Buscar produtos, artigos e páginas..."
        aria-label="Buscar"
      >
      <button type="submit" class="btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="sr-only">Buscar</span>
      </button>
    </form>

    {%- if search.performed -%}
      <div class="search-results">
        {%- if search.results_count == 0 -%}
          <p class="search-no-results">Nenhum resultado encontrado para "{{ search.terms }}".</p>
        {%- else -%}
          <p class="search-count">{{ search.results_count }} resultado(s) encontrado(s).</p>

          {%- if section.settings.enable_filters -%}
            <div class="search-filters">
              <label for="filter-type">Tipo</label>
              <select id="filter-type" name="type" onchange="this.form.submit()">
                <option value="">Todos</option>
                <option value="product"{% if search.filters.type == 'product' %} selected{% endif %}>Produtos</option>
                <option value="article"{% if search.filters.type == 'article' %} selected{% endif %}>Artigos</option>
                <option value="page"{% if search.filters.type == 'page' %} selected{% endif %}>Páginas</option>
              </select>
            </div>
          {%- endif -%}

          <div class="search-results-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- elsif item.object_type == 'article' -%}
                {% render 'article-card', article: item %}
              {%- elsif item.object_type == 'page' -%}
                <div class="search-result-page">
                  <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p>{{ item.content | strip_html | truncate: 150 }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Busca",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Ativar Filtros",
      "default": true
    }
  ]
}
{% endschema %}
