{%- layout 'theme' -%}

<div class="container">
  <h1>{{ page_title }}</h1>
  
  {%- if section.settings.show_page_image and page.image -%}
    <div class="page__image">
      <img 
        src="{{ page.image | image_url: width: 1200 }}" 
        alt="{{ page.image.alt | escape }}"
        loading="eager"
      >
    </div>
  {%- endif -%}

  <div class="page-content rte">
    {{ content_for_layout }}
  </div>
</div>

{% schema %}
{
  "name": "Página",
  "tag": "section",
  "class": "section-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_page_image",
      "label": "Mostrar Imagem da Página",
      "default": true
    }
  ]
}
{% endschema %}
