{%- layout 'theme' -%}

<article class="article">
  <div class="container">
    {%- if article.image -%}
      <div class="article__image">
        <img 
          src="{{ article.image | image_url: width: 1200 }}" 
          alt="{{ article.image.alt | escape }}"
          loading="eager"
        >
      </div>
    {%- endif -%}

    <header class="article__header">
      <h1>{{ article.title }}</h1>
      
      {%- if article.author or article.published_at -%}
        <div class="article__meta">
          {%- if article.author -%}
            <span class="article__author">{{ article.author }}</span>
          {%- endif -%}
          
          {%- if article.published_at -%}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="article__date">
              {{ article.published_at | date: "%d de %B, %Y" }}
            </time>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    <div class="article__content rte">
      {{ article.content }}
    </div>

    {%- if article.tags.size > 0 -%}
      <div class="article__tags">
        <span>Tags:</span>
        <ul>
          {%- for tag in article.tags -%}
            <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <div class="article__comments">
        {% if article.comments_count > 0 %}
          <h2>{{ article.comments_count }} comentários</h2>
        {% endif %}
        
        {% form 'new_comment', article %}
          <h3>Deixe um comentário</h3>
          
          {%- if form.posted_successfully? -%}
            <p class="form-success">Comentário postado com sucesso!</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-errors">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="form-field">
            <label for="comment-author">Nome</label>
            <input type="text" id="comment-author" name="comment[author]" value="{{ form.author }}" required>
          </div>

          <div class="form-field">
            <label for="comment-email">Email</label>
            <input type="email" id="comment-email" name="comment[email]" value="{{ form.email }}" required>
          </div>

          <div class="form-field">
            <label for="comment-content">Comentário</label>
            <textarea id="comment-content" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn">Postar Comentário</button>
        {% endform %}

        <div class="comments-list">
          {%- for comment in article.comments -%}
            <div class="comment">
              <div class="comment__author">{{ comment.author }}</div>
              <div class="comment__date">{{ comment.created_at | date: "%d de %B, %Y" }}</div>
              <div class="comment__content">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Artigo",
  "tag": "article",
  "class": "section-article"
}
{% endschema %}
