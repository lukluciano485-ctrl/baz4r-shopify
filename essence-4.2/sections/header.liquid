{%- style -%}
  /* ===== HEADER ===== */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-header-background);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow 0.3s ease;
    height: var(--header-height);
  }

  .site-header.is-sticky {
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .header-main {
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .mobile-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-header-text);
  }

  .mobile-nav-toggle svg {
    width: 24px;
    height: 24px;
  }

  .search-open-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-header-text);
    font-size: 14px;
  }

  .search-open-btn svg {
    width: 24px;
    height: 24px;
  }

  .header-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-logo__image {
    max-width: 220px;
    height: auto;
  }

  @media (max-width: 700px) {
    .header-logo__image {
      max-width: 160px;
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  .menu-icon-cart,
  .menu-icon-wishlist,
  .menu-icon-user {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-header-text);
    cursor: pointer;
  }

  .menu-icon-cart svg,
  .menu-icon-wishlist svg,
  .menu-icon-user svg {
    width: 24px;
    height: 24px;
  }

  .badge-counter {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-counters);
    color: white;
    font-size: 10px;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
  }

  .badge-counter.d-none {
    display: none !important;
  }

  .desktop-nav-links {
    display: none;
  }

  @media (min-width: 992px) {
    .desktop-nav-links {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .mobile-nav-toggle {
      display: none;
    }

    .search-open-btn {
      display: flex;
    }
  }

  @media (max-width: 991px) {
    .desktop-nav-links {
      display: none;
    }

    .search-open-btn span {
      display: none;
    }
  }
{%- endstyle -%}

<header class="site-header" id="shopify-section-header">
  <div class="container header-main">
    <!-- Coluna Esquerda -->
    <div class="col-3 header-left">
      <!-- Mobile: Hamburguer + Lupa -->
      <button class="mobile-nav-toggle" aria-label="Abrir menu" aria-controls="MobileDrawer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Desktop: Pesquisar + Conta -->
      <div class="desktop-nav-links">
        <button class="search-open-btn" aria-label="Pesquisar">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span>Pesquisar</span>
        </button>
        
        <a href="{{ routes.account_url }}" class="menu-icon-user" aria-label="Conta">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Conta</span>
        </a>
      </div>

      <!-- Mobile: Apenas lupa -->
      <button class="search-open-btn d-md-none" aria-label="Pesquisar">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>

    <!-- Coluna Central: Logo -->
    <div class="col-6 header-logo">
      {% if section.settings.logo %}
        <a href="{{ routes.root_url }}" class="header-logo__link">
          <img 
            src="{{ section.settings.logo | image_url: width: 440 }}" 
            alt="{{ shop.name }}"
            class="header-logo__image"
            loading="eager"
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
          >
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="header-logo__link">
          <h1 style="font-size: 24px; font-weight: 700; color: var(--color-header-text);">
            {{ shop.name }}
          </h1>
        </a>
      {% endif %}
    </div>

    <!-- Coluna Direita -->
    <div class="col-3 header-right">
      <!-- Wishlist -->
      <a href="{{ routes.all_products_collection_url }}" class="menu-icon-wishlist" aria-label="Favoritos">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span class="d-md-block">Favoritos</span>
        <span class="badge-counter cart-count-badge d-none">0</span>
      </a>

      <!-- Cart -->
      <button class="menu-icon-cart" aria-label="Carrinho" id="cart-drawer-toggle">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="d-md-block">Carrinho</span>
        <span class="badge-counter cart-count-badge d-none">0</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Sticky Header
  const header = document.querySelector('.site-header');
  let lastScrollTop = 0;
  
  window.addEventListener('scroll', function() {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    
    if (scrollTop > lastScrollTop && scrollTop > 100) {
      header.classList.remove('is-sticky');
    } else {
      header.classList.add('is-sticky');
    }
    
    lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
  });

  // Cart Drawer Toggle
  document.getElementById('cart-drawer-toggle')?.addEventListener('click', function() {
    const cartDrawer = document.querySelector('.cart-drawer');
    const overlay = document.querySelector('.cart-overlay');
    
    if (cartDrawer && overlay) {
      cartDrawer.classList.add('open');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  });
</script>

{% schema %}
{
  "name": "Cabeçalho",
  "tag": "header",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo da Loja"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Largura da Logo",
      "default": 220
    }
  ],
  "presets": [
    {
      "name": "Cabeçalho"
    }
  ]
}
{% endschema %}
