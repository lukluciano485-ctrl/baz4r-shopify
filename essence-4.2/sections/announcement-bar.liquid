{%- style -%}
  /* ===== ANNOUNCEMENT BAR ===== */
  .announcement-bar {
    display: flex;
    align-items: center;
    height: 40px;
    background: var(--color-topbar-background);
    color: var(--color-topbar-text);
    font-size: 13px;
  }

  .announcement-social {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .announcement-social a {
    color: #fff;
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }

  .announcement-social a:hover {
    opacity: 0.7;
  }

  .announcement-social svg {
    width: 16px;
    height: 16px;
  }

  .announcement-swiper-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    overflow: hidden;
  }

  .announcement-swiper {
    width: 100%;
    height: 40px;
  }

  .announcement-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .announcement-text {
    font-weight: 700;
    font-size: 14px;
    color: #fff;
  }

  .announcement-contact-wrapper {
    position: relative;
  }

  .announcement-contact-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    color: #000;
    height: 24px;
    padding: 0 8px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .announcement-contact-btn:hover {
    background: #f0f0f0;
  }

  .announcement-contact-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background: white;
    color: #282828;
    border: 1px solid #E0E0E0;
    min-width: 240px;
    padding: 12px;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    z-index: 100;
    margin-top: 8px;
  }

  .announcement-contact-wrapper:hover .announcement-contact-dropdown {
    display: block;
  }

  .announcement-contact-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    font-size: 13px;
    border-bottom: 1px solid #f0f0f0;
  }

  .announcement-contact-item:last-child {
    border-bottom: none;
  }

  .announcement-contact-item svg {
    width: 16px;
    height: 16px;
    color: #666;
  }

  .announcement-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    color: #fff;
    padding: 4px;
    z-index: 10;
  }

  .announcement-prev {
    left: 4px;
  }

  .announcement-next {
    right: 4px;
  }

  .announcement-nav svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 991px) {
    .announcement-bar {
      flex-wrap: wrap;
      height: auto;
      padding: 8px 0;
    }

    .announcement-social {
      order: 1;
      width: 100%;
      justify-content: center;
      margin-bottom: 8px;
    }

    .announcement-swiper-container {
      order: 3;
      width: 100%;
      max-width: 100%;
      margin-top: 8px;
    }

    .announcement-contact-wrapper {
      order: 2;
    }
  }
{%- endstyle -%}

