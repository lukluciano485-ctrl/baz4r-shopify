        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Inicializar Swiper da Announcement Bar
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.announcement-swiper', {
      loop: true,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false
      },
      effect: 'fade',
      navigation: {
        nextEl: '.announcement-next',
        prevEl: '.announcement-prev'
      }
    });
  });
</script>

{% schema %}
{
  "name": "Barra de Anúncio",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Redes Sociais"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Link do Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Link do Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "Link do TikTok"
    },
    {
      "type": "url",
      "id": "social_youtube_link",
      "label": "Link do YouTube"
    },
    {
      "type": "header",
      "content": "Contato"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Telefone",
      "default": "(11) 9 9999-9999"
    },
    {
      "type": "text",
      "id": "contact_whatsapp",
      "label": "WhatsApp",
      "default": "Fale no WhatsApp"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "email@sualoja.com.br"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "Horário de Atendimento",
      "default": "Segunda a Sexta das 9h às 16h"
    }
  ],
  "presets": [
    {
      "name": "Barra de Anúncio"
    }
  ]
}
{% endschema %}
