      </div>
    </div>

    <!-- Coluna Central: Swiper de Mensagens -->
    <div class="col-6 content-center">
      <div class="announcement-swiper-container">
        <button class="announcement-nav announcement-prev" aria-label="Anterior">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        
        <div class="swiper announcement-swiper">
          <div class="swiper-wrapper">
            <div class="swiper-slide announcement-slide">
              <span class="announcement-text">Frete grátis para todo Brasil</span>
            </div>
            <div class="swiper-slide announcement-slide">
              <span class="announcement-text">10% OFF pagando no PIX</span>
            </div>
            <div class="swiper-slide announcement-slide">
              <span class="announcement-text">Parcele em até 6x sem juros</span>
            </div>
          </div>
        </div>
        
        <button class="announcement-nav announcement-next" aria-label="Próximo">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
