<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__top">
      <div class="footer__col">
        <h5 class="footer-block__heading">{{ 'sections.footer.about_us' | t }}</h5>
        <p class="footer__description">{{ settings.footer_description }}</p>
        
        <div class="footer__social">
          {%- if settings.social_facebook_link -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          {%- endif -%}
          
          {%- if settings.social_instagram_link -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          
          {%- if settings.social_tiktok_link -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
          {%- endif -%}
          
          {%- if settings.social_youtube_link -%}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33zM9.75 15.02l5.75-3.27-5.75-3.27z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
      
      <div class="footer__col">
        <h5 class="footer-block__heading">{{ 'sections.footer.menu' | t }}</h5>
        <ul class="footer-menu">
          <li>
            <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
            <a href="/">{{ 'sections.footer.home' | t }}</a>
          </li>
          <li>
            <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
            <a href="/collections">{{ 'sections.footer.collections' | t }}</a>
          </li>
          <li>
            <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
            <a href="/collections/all">{{ 'sections.footer.catalog' | t }}</a>
          </li>
          <li>
            <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
            <a href="/pages/contact">{{ 'sections.footer.contact' | t }}</a>
          </li>
          <li>
            <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
            <a href="/apps/order-tracking">{{ 'sections.footer.track_order' | t }}</a>
          </li>
        </ul>
      </div>
      
      <div class="footer__col">
        <h5 class="footer-block__heading">{{ 'sections.footer.policies' | t }}</h5>
        <ul class="footer-menu">
          {%- for policy in shop.policies -%}
            {%- if policy != null -%}
              <li>
                <svg width="5" height="5" viewBox="0 0 5 5" fill="currentColor" style="display:inline-block;vertical-align:middle;margin-right:6px;"><circle cx="2.5" cy="2.5" r="2.5"/></svg>
                <a href="{{ policy.url }}">{{ policy.title }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      
      <div class="footer__col">
        <h5 class="footer-block__heading">{{ 'sections.footer.newsletter_title' | t }}</h5>
        <p class="footer__newsletter-text">{{ 'sections.footer.newsletter_text' | t }}</p>
        
        {% form 'customer', class: 'footer-newsletter-form' %}
          {{ form.errors | default_errors }}
          
          <div class="footer-newsletter-form__group">
            <input 
              type="email" 
              name="contact[email]" 
              placeholder="{{ 'sections.footer.email_placeholder' | t }}" 
              class="footer-newsletter-form__input" 
              required
              aria-label="{{ 'sections.footer.email_label' | t }}"
            >
            <button type="submit" class="footer-newsletter-form__btn" aria-label="{{ 'sections.footer.subscribe' | t }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </button>
          </div>
        {% endform %}
      </div>
    </div>
    
    <div class="footer__bottom">
      <div class="footer__copyright">
        <p>&copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}. {{ 'sections.footer.copyright' | t }}</p>
        <p class="footer__security">{{ 'sections.footer.security_text' | t }}</p>
      </div>
      
      <div class="footer__payments">
        <span class="titulos">{{ 'sections.footer.payment_methods' | t }}</span>
        <div class="payment-list">
          <!-- Mastercard -->
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none">
            <rect width="38" height="24" rx="4" fill="#EBEBEB"/>
            <circle cx="14" cy="12" r="6" fill="#EB001B"/>
            <circle cx="24" cy="12" r="6" fill="#F79E1B"/>
            <path d="M19 12C19 13.6569 18.1266 15.1111 16.818 15.9111C15.5094 15.1111 14.636 13.6569 14.636 12C14.636 10.3431 15.5094 8.88889 16.818 8.08889C18.1266 8.88889 19 10.3431 19 12Z" fill="#FF5F00"/>
          </svg>
          
          <!-- Visa -->
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none">
            <rect width="38" height="24" rx="4" fill="#EBEBEB"/>
            <text x="19" y="16" font-family="Arial, sans-serif" font-size="10" font-weight="bold" fill="#1A1F71" text-anchor="middle">VISA</text>
          </svg>
          
          <!-- Elo -->
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none">
            <rect width="38" height="24" rx="4" fill="#EBEBEB"/>
            <text x="19" y="16" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#000" text-anchor="middle">Elo</text>
          </svg>
          
          <!-- Boleto -->
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none">
            <rect width="38" height="24" rx="4" fill="#EBEBEB"/>
            <rect x="8" y="8" width="4" height="8" fill="#000"/>
            <rect x="14" y="6" width="4" height="12" fill="#000"/>
            <rect x="20" y="8" width="4" height="8" fill="#000"/>
            <rect x="26" y="6" width="4" height="12" fill="#000"/>
          </svg>
          
          <!-- Pix -->
          <svg width="38" height="24" viewBox="0 0 38 24" fill="none">
            <rect width="38" height="24" rx="4" fill="#EBEBEB"/>
            <path d="M19 7L24 12L19 17L14 12L19 7Z" fill="#32BCAD"/>
            <circle cx="19" cy="12" r="2" fill="#fff"/>
          </svg>
        </div>
      </div>
      
      <div class="footer__security-badges selos">
        <span class="titulos">{{ 'sections.footer.security_badges' | t }}</span>
        <div class="payment-list">
          <!-- Google Safe -->
          <svg width="60" height="30" viewBox="0 0 60 30" fill="none">
            <rect width="60" height="30" rx="4" fill="#EBEBEB"/>
            <text x="30" y="18" font-family="Arial, sans-serif" font-size="8" fill="#32BCAD" text-anchor="middle">Google Safe</text>
          </svg>
          
          <!-- Shopify Secure -->
          <svg width="80" height="30" viewBox="0 0 80 30" fill="none">
            <rect width="80" height="30" rx="4" fill="#EBEBEB"/>
            <text x="40" y="18" font-family="Arial, sans-serif" font-size="8" fill="#5E8E3E" text-anchor="middle">Shopify Secure</text>
          </svg>
        </div>
      </div>
      
      <div class="footer__shipping selos">
        <span class="titulos">{{ 'sections.footer.shipping' | t }}</span>
        <div class="payment-list">
          <!-- Correios -->
          <svg width="60" height="30" viewBox="0 0 60 30" fill="none">
            <rect width="60" height="30" rx="4" fill="#EBEBEB"/>
            <text x="30" y="18" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#00416B" text-anchor="middle">Correios</text>
          </svg>
          
          <!-- Loggi -->
          <svg width="60" height="30" viewBox="0 0 60 30" fill="none">
            <rect width="60" height="30" rx="4" fill="#EBEBEB"/>
            <text x="30" y="18" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#F37021" text-anchor="middle">Loggi</text>
          </svg>
          
          <!-- Jadlog -->
          <svg width="60" height="30" viewBox="0 0 60 30" fill="none">
            <rect width="60" height="30" rx="4" fill="#EBEBEB"/>
            <text x="30" y="18" font-family="Arial, sans-serif" font-size="9" font-weight="bold" fill="#FFD100" text-anchor="middle">Jadlog</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
.footer { background: var(--color-footer-background, #282828); color: var(--color-footer-text, #ffffff); padding: 32px 0; margin-top: 48px; }
.footer__top { display: grid; grid-template-columns: 1fr; gap: 32px; margin-bottom: 32px; }
@media (min-width: 768px) {
  .footer__top { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 992px) {
  .footer__top { grid-template-columns: repeat(4, 1fr); }
}
.footer-block__heading { font-size: 15px; font-weight: 600; margin-bottom: 16px; color: var(--color-footer-heading, #fff); }
.footer__description { font-size: 14px; line-height: 1.6; opacity: 0.85; margin-bottom: 16px; }
.footer__social { display: flex; gap: 12px; }
.footer__social a { color: #fff; opacity: 0.85; transition: opacity 0.2s; }
.footer__social a:hover { opacity: 1; }
.footer-menu { list-style: none; padding: 0; margin: 0; }
.footer-menu li { margin-bottom: 10px; }
.footer-menu a { font-size: 14px; opacity: 0.85; transition: opacity 0.2s; }
.footer-menu a:hover { opacity: 1; text-decoration: underline; }
.footer__newsletter-text { font-size: 14px; margin-bottom: 12px; opacity: 0.85; }
.footer-newsletter-form__group { display: flex; }
.footer-newsletter-form__input { flex: 1; border: 1px solid #555; background: #3a3a3a; color: white; padding: 10px 12px; border-radius: 4px 0 0 4px; font-size: 14px; outline: none; }
.footer-newsletter-form__input::placeholder { color: #999; }
.footer-newsletter-form__btn { background: #000; color: white; border: none; padding: 10px 14px; border-radius: 0 4px 4px 0; cursor: pointer; transition: background 0.2s; }
.footer-newsletter-form__btn:hover { background: #333; }
.footer__bottom { border-top: 1px solid #444; padding-top: 20px; }
.footer__copyright { text-align: center; font-size: 12px; opacity: 0.7; line-height: 1.6; margin-bottom: 20px; }
.footer__security { font-size: 11px; margin-top: 4px; }
.titulos { font-size: 12px; font-weight: 600; opacity: 0.7; display: block; margin-bottom: 8px; }
.payment-list { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 16px; }
.selos { margin-top: 16px; }
@media (max-width: 767px) {
  .payment-list svg { width: 32px; height: 20px; }
}
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": []
}
{% endschema %}
