{%- style -%}
  /* ===== PRODUCT CARD ===== */
  .product-card {
    position: relative;
  }

  .product-card__container {
    position: relative;
  }

  .product-card__top {
    position: relative;
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
  }

  .media--square {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-image-background);
  }

  .media--square img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .secondary-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .image-hover:hover .secondary-img {
    opacity: 1;
  }

  .image-hover:hover .primary-img {
    transform: scale(1.03);
  }

  .wide-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .discount_card {
    position: absolute;
    top: 0;
    left: 0;
    background: var(--color-product-label-sale-bg);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    z-index: 2;
    border-radius: 0 0 4px 0;
  }

  .product-card__label.absolute {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
  }

  .product-card__btns {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .product-card:hover .product-card__btns {
    opacity: 1;
  }

  .product-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .product-btn:hover {
    background: #333;
  }

  .wishlist-btn {
    background: white;
    color: #000;
    border: 1px solid #E0E0E0;
  }

  .wishlist-btn:hover {
    background: #f5f5f5;
  }

  .wishlist-btn--active {
    display: none;
  }

  .wishlist-btn.active + .wishlist-btn--active {
    display: flex;
  }

  .wishlist-btn.active ~ .wishlist-btn:not(.wishlist-btn--active) {
    display: none;
  }

  .product-card__bottom {
    padding: 8px 0;
  }

  .product-card__border {
    border-top: 1px solid var(--color-border);
    margin-top: 8px;
    padding-top: 8px;
  }

  .product-title a {
    font-size: 14px;
    color: var(--color-product-title);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }

  .product-title a:hover {
    color: var(--color-text-link-hover);
  }

  .card-price--on-sale .card-price__sale--discounted-from {
    text-decoration: line-through;
    font-size: 12px;
    color: var(--color-subtext);
  }

  .card-pix {
    font-size: 14px;
    margin: 4px 0;
  }

  .card-pix b {
    font-weight: 700;
    color: var(--color-product-sale-price);
  }

  .card-parcela {
    font-size: 12px;
    color: var(--color-secondary-text);
  }

  .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #f1f1f1;
  }
{%- endstyle -%}
