<!-- Newsletter Popup -->
<div class="pop-up" id="newsletterPopup">
  <div class="pop-up__overlay" id="popupOverlay"></div>
  <div class="pop-up__container">
    <button class="pop-up__close" id="popupClose" aria-label="{{ 'sections.newsletter.close' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    
    <div class="pop-up__content">
      <h3>{{ 'sections.newsletter.title' | t }}</h3>
      <p class="pop-up__subtitle">{{ 'sections.newsletter.subtitle' | t }}</p>
      
      {% form 'customer', class: 'newsletter-form' %}
        {{ form.errors | default_errors }}
        
        <div class="newsletter-form__group">
          <input 
            type="email" 
            name="contact[email]" 
            placeholder="{{ 'sections.newsletter.email_placeholder' | t }}" 
            class="newsletter-form__input" 
            required
            aria-label="{{ 'sections.newsletter.email_label' | t }}"
          >
          <button type="submit" class="newsletter-form__btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </div>
        
        <p class="newsletter-form__privacy">{{ 'sections.newsletter.privacy' | t }}</p>
      {% endform %}
      
      <div class="pop-up__social">
        <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
          </svg>
        </a>
        <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33zM9.75 15.02l5.75-3.27-5.75-3.27z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
.pop-up { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center; padding: 20px; }
.pop-up.active { display: flex; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.pop-up__overlay { position: absolute; inset: 0; }
.pop-up__container { background: white; border-radius: 8px; max-width: 520px; width: 100%; padding: 32px; position: relative; z-index: 1; animation: popIn 0.3s ease; }
@keyframes popIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.pop-up__close { position: absolute; top: 16px; right: 16px; background: none; border: none; cursor: pointer; color: var(--color-body-text); padding: 4px; }
.pop-up__close:hover { color: var(--color-text-link-hover); }
.pop-up__content h3 { font-size: 24px; font-weight: 600; margin-bottom: 8px; text-align: center; }
.pop-up__subtitle { text-align: center; color: var(--color-secondary-text); margin-bottom: 24px; }
.newsletter-form__group { display: flex; gap: 0; margin-bottom: 12px; }
.newsletter-form__input { flex: 1; border: 1px solid #555; background: #3a3a3a; color: white; padding: 12px 16px; border-radius: 4px 0 0 4px; font-size: 14px; outline: none; }
.newsletter-form__input::placeholder { color: #999; }
.newsletter-form__input:focus { border-color: #000; }
.newsletter-form__btn { background: #000; color: white; border: none; padding: 12px 16px; border-radius: 0 4px 4px 0; cursor: pointer; transition: background 0.2s; }
.newsletter-form__btn:hover { background: #333; }
.newsletter-form__privacy { font-size: 12px; color: var(--color-subtext); text-align: center; margin-bottom: 20px; }
.pop-up__social { display: flex; justify-content: center; gap: 16px; }
.pop-up__social a { color: var(--color-body-text); transition: color 0.2s; }
.pop-up__social a:hover { color: var(--color-text-link-hover); }
@media (max-width: 576px) {
  .pop-up__container { padding: 24px; }
  .pop-up__content h3 { font-size: 20px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const popup = document.getElementById('newsletterPopup');
  const closeBtn = document.getElementById('popupClose');
  const overlay = document.getElementById('popupOverlay');
  
  // Verificar se já foi exibido
  const hasBeenShown = localStorage.getItem('newsletter_shown_' + window.location.hostname);
  
  if (!hasBeenShown && popup) {
    // Exibir após 8 segundos
    setTimeout(() => {
      popup.classList.add('active');
      localStorage.setItem('newsletter_shown_' + window.location.hostname, '1');
    }, 8000);
  }
  
  // Fechar popup
  function closePopup() {
    if (popup) {
      popup.classList.remove('active');
    }
  }
  
  if (closeBtn) {
    closeBtn.addEventListener('click', closePopup);
  }
  
  if (overlay) {
    overlay.addEventListener('click', closePopup);
  }
  
  // Fechar com ESC
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && popup && popup.classList.contains('active')) {
      closePopup();
    }
  });
});
</script>
