<!-- Help Button Flutuante -->
<div class="help-customer" id="helpCustomer">
  <ul class="list-options-help">
    <li>
      <a href="/collections/all">
        <span>{{ 'sections.help.promotions' | t }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v20M2 12h20"/>
        </svg>
      </a>
    </li>
    <li>
      <a href="{{ routes.cart_url }}">
        <span>{{ 'sections.help.buy_with_attendant' | t }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 6v6l4 2"/>
        </svg>
      </a>
    </li>
    <li>
      <a href="/pages/faq">
        <span>{{ 'sections.help.faq' | t }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </a>
    </li>
    <li>
      <a href="/apps/order-tracking">
        <span>{{ 'sections.help.track_order' | t }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"/>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </a>
    </li>
  </ul>
  <button class="help-button" id="helpButton" aria-label="{{ 'sections.help.button_label' | t }}">
    <span class="help-button-text">{{ 'sections.help.button_text' | t }}</span>
  </button>
  <a href="{{ settings.whatsapp_link }}" class="help-whatsapp" target="_blank" rel="noopener">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
</div>

<style>
.help-customer { position: fixed; bottom: 100px; right: 0; display: flex; flex-direction: column; align-items: flex-end; z-index: 23; }
.help-button { width: 45px; height: 65px; border: 1px solid var(--color-border); border-right: 0; background: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.help-button:hover { background: #f5f5f5; }
.help-button-text { transform: rotate(270deg); font-size: 12px; font-weight: 600; white-space: nowrap; color: var(--color-body-text); }
.list-options-help { list-style: none; position: fixed; bottom: 200px; right: -251px; background: white; transition: right 0.2s linear; padding: 0; margin: 0; box-shadow: -2px 0 8px rgba(0,0,0,0.1); z-index: 24; }
.help-customer.showlist .list-options-help { right: 0; }
.list-options-help li a { display: flex; align-items: center; justify-content: space-between; width: 251px; height: 45px; border-top: 1px solid #E0E0E0; border-left: 1px solid #E0E0E0; font-size: 13px; padding: 0 12px; color: var(--color-body-text); }
.list-options-help li a:hover { background: #f5f5f5; }
.help-whatsapp { width: 45px; height: 45px; border: 1px solid var(--color-border); border-right: 0; background: #fff; display: flex; align-items: center; justify-content: center; margin-top: 4px; transition: background 0.2s; }
.help-whatsapp:hover { background: #f5f5f5; }
.help-whatsapp svg { color: #25D366; }
@media (max-width: 767px) {
  .help-customer { bottom: 80px; }
  .list-options-help { bottom: 180px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const helpButton = document.getElementById('helpButton');
  const helpCustomer = document.getElementById('helpCustomer');
  
  if (helpButton && helpCustomer) {
    helpButton.addEventListener('click', function() {
      helpCustomer.classList.toggle('showlist');
    });
    
    // Fechar ao clicar fora
    document.addEventListener('click', function(e) {
      if (!helpCustomer.contains(e.target)) {
        helpCustomer.classList.remove('showlist');
      }
    });
  }
});
</script>
