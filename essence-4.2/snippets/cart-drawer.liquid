<!-- Cart Drawer -->
<div class="cart-overlay" id="cartOverlay"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-drawer__header">
    <h2>{{ 'sections.cart.title' | t }}</h2>
    <button class="cart-drawer__close" id="cartDrawerClose" aria-label="{{ 'sections.cart.close' | t }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
  
  <div class="cart-drawer__body" id="cartDrawerBody">
    <!-- Conteúdo carregado via AJAX -->
    <div class="cart-drawer__empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="9" cy="21" r="1"/>
        <circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <p>{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">
        {{ 'sections.cart.continue_shopping' | t }}
      </a>
    </div>
  </div>
  
  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>{{ 'sections.cart.subtotal' | t }}:</span>
      <span id="cartDrawerSubtotal">{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer__shipping-note">{{ 'sections.cart.shipping_note' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout">
      <button type="submit" name="checkout" class="btn btn-checkout" {% if cart.item_count == 0 %}disabled{% endif %}>
        {{ 'sections.cart.checkout' | t }}
      </button>
    </form>
  </div>
</div>

<style>
.cart-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 299; }
.cart-overlay.active { display: block; }
.cart-drawer { position: fixed; right: 0; top: 0; height: 100%; width: 380px; max-width: 100%; background: white; z-index: 300; transform: translateX(100%); transition: transform 0.3s ease; box-shadow: -4px 0 24px rgba(0,0,0,0.1); display: flex; flex-direction: column; }
.cart-drawer.open { transform: translateX(0); }
.cart-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--color-border); }
.cart-drawer__header h2 { font-size: 16px; font-weight: 600; margin: 0; }
.cart-drawer__close { background: none; border: none; cursor: pointer; color: var(--color-body-text); padding: 4px; }
.cart-drawer__body { flex: 1; overflow-y: auto; padding: 20px; }
.cart-drawer__empty { text-align: center; padding: 40px 20px; }
.cart-drawer__empty svg { color: var(--color-subtext); margin-bottom: 16px; }
.cart-drawer__empty p { color: var(--color-secondary-text); margin-bottom: 20px; }
.cart-drawer__footer { padding: 20px; border-top: 1px solid var(--color-border); background: #fafafa; }
.cart-drawer__subtotal { display: flex; justify-content: space-between; font-size: 16px; font-weight: 600; margin-bottom: 8px; }
.cart-drawer__shipping-note { font-size: 12px; color: var(--color-subtext); margin-bottom: 16px; }
.cart-drawer__checkout .btn-checkout { width: 100%; background: var(--color-btn-bg); color: var(--color-btn-text); border: none; padding: 14px 20px; font-size: 14px; font-weight: 600; cursor: pointer; border-radius: 4px; transition: background 0.2s; }
.cart-drawer__checkout .btn-checkout:hover:not(:disabled) { background: var(--color-btn-bg-hover); }
.cart-drawer__checkout .btn-checkout:disabled { opacity: 0.5; cursor: not-allowed; }
.cart-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--color-border); }
.cart-item__image { width: 60px; height: 60px; object-fit: cover; border-radius: 4px; }
.cart-item__details { flex: 1; }
.cart-item__title { font-size: 14px; font-weight: 500; margin-bottom: 4px; }
.cart-item__price { font-size: 13px; color: var(--color-secondary-text); }
.cart-item__quantity { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
.cart-item__qty-btn { width: 28px; height: 28px; border: 1px solid var(--color-border); background: white; cursor: pointer; border-radius: 4px; }
.cart-item__qty-input { width: 40px; text-align: center; border: 1px solid var(--color-border); border-radius: 4px; }
.cart-item__remove { color: var(--color-error); font-size: 12px; background: none; border: none; cursor: pointer; margin-top: 8px; }
@media (max-width: 576px) {
  .cart-drawer { width: 100%; }
}
</style>

<script>
class CartDrawer {
  constructor() {
    this.drawer = document.getElementById('cartDrawer');
    this.overlay = document.getElementById('cartOverlay');
    this.closeBtn = document.getElementById('cartDrawerClose');
    this.body = document.getElementById('cartDrawerBody');
    this.subtotalEl = document.getElementById('cartDrawerSubtotal');
    
    this.init();
  }
  
  init() {
    // Event listeners para abrir o drawer (ícones do header)
    document.querySelectorAll('.cart-open').forEach(btn => {
      btn.addEventListener('click', () => this.open());
    });
    
    if (this.closeBtn) {
      this.closeBtn.addEventListener('click', () => this.close());
    }
    
    if (this.overlay) {
      this.overlay.addEventListener('click', () => this.close());
    }
    
    // Fechar com ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && this.drawer.classList.contains('open')) {
        this.close();
      }
    });
  }
  
  open() {
    if (this.drawer && this.overlay) {
      this.drawer.classList.add('open');
      this.overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      this.fetchCart();
    }
  }
  
  close() {
    if (this.drawer && this.overlay) {
      this.drawer.classList.remove('open');
      this.overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
  }
  
  fetchCart() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => this.renderCart(cart))
      .catch(err => console.error('Error fetching cart:', err));
  }
  
  renderCart(cart) {
    if (cart.item_count === 0) {
      this.body.innerHTML = `
        <div class="cart-drawer__empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <p>${window.cartStrings.empty || 'Seu carrinho está vazio'}</p>
          <a href="${window.routes.all_products_collection_url || '/collections/all'}" class="btn btn-primary">${window.cartStrings.continueShopping || 'Continuar comprando'}</a>
        </div>
      `;
      this.subtotalEl.textContent = this.formatMoney(cart.total_price);
      return;
    }
    
    const itemsHTML = cart.items.map(item => `
      <div class="cart-item" data-line="${item.key}">
        <img src="${item.image}" alt="${item.product_title}" class="cart-item__image">
        <div class="cart-item__details">
          <div class="cart-item__title">${item.product_title}</div>
          <div class="cart-item__price">${this.formatMoney(item.final_line_price)}</div>
          <div class="cart-item__quantity">
            <button class="cart-item__qty-btn" onclick="cartDrawer.updateQuantity(${item.key}, ${item.quantity - 1})">−</button>
            <input type="number" value="${item.quantity}" min="1" class="cart-item__qty-input" readonly>
            <button class="cart-item__qty-btn" onclick="cartDrawer.updateQuantity(${item.key}, ${item.quantity + 1})">+</button>
          </div>
          <button class="cart-item__remove" onclick="cartDrawer.removeItem(${item.key})">${window.cartStrings.remove || 'Remover'}</button>
        </div>
      </div>
    `).join('');
    
    this.body.innerHTML = itemsHTML;
    this.subtotalEl.textContent = this.formatMoney(cart.total_price);
  }
  
  updateQuantity(key, quantity) {
    if (quantity < 1) {
      this.removeItem(key);
      return;
    }
    
    fetch(window.routes.cart_change_url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: key, quantity: quantity })
    })
    .then(response => response.json())
    .then(cart => {
      this.renderCart(cart);
      updateCartCount(cart.item_count);
    })
    .catch(err => console.error('Error updating quantity:', err));
  }
  
  removeItem(key) {
    fetch(window.routes.cart_change_url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ line: key, quantity: 0 })
    })
    .then(response => response.json())
    .then(cart => {
      this.renderCart(cart);
      updateCartCount(cart.item_count);
    })
    .catch(err => console.error('Error removing item:', err));
  }
  
  formatMoney(cents) {
    const amount = cents / 100;
    return amount.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }
}

// Inicializar cart drawer
const cartDrawer = new CartDrawer();

// Expor funções globalmente para os callbacks inline
window.cartDrawer = cartDrawer;
</script>
